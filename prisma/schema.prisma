// HEAT World Championship (HWC) — V1 data model, extended for V2 Phase 1
// See section 32-33 of the V1 build spec for the reasoning behind the base
// shape, and sections 7 & 10-11 of the V2 build spec for the additions
// below (driver numbers, championship-specific teams).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PLAYER
}

enum ChampionshipStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum RaceStatus {
  UPCOMING
  OPEN
  COMPLETED
}

enum ResultStatus {
  FINISHED
  DNF
  DNS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PLAYER)
  createdAt    DateTime @default(now())

  submittedResults RaceResult[] @relation("ResultSubmittedBy")
  completedRaces   Race[]       @relation("RaceSubmittedBy")
  driverProfile    Driver?

  @@map("users")
}

// Drivers exist independently of any championship (spec section 7) so the
// same person/car can be added to many seasons and, later, accrue
// career-wide stats without a schema change.
model Driver {
  id        String   @id @default(cuid())
  name      String
  nickname  String?
  carColour String
  avatarUrl String?
  createdAt DateTime @default(now())

  // V2: permanent HWC driver number (V2 spec section 7). Belongs to the
  // driver, not any one championship. Nullable because existing V1 drivers
  // won't have one yet — admin assigns during migration or later via admin
  // settings (V2 spec section 42). Once set it should not change casually;
  // that's an app-layer rule, not a DB one, so admin can still correct a
  // mistake.
  driverNumber Int? @unique

  // Optional link to a real login account, so a driver's on-track record
  // can be tied back to the person who actually plays them. Nullable
  // because plenty of drivers (kids, guests, anyone without a login) will
  // never have an account — those stay freeform, name-only.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  championships ChampionshipDriver[]
  results       RaceResult[]
  teams         ChampionshipDriverTeam[]

  @@map("drivers")
}

model Championship {
  id            String             @id @default(cuid())
  name          String
  year          Int
  numberOfRaces Int                @default(8)
  status        ChampionshipStatus @default(UPCOMING)

  // Points awarded per finishing position, plus DNF/DNS handling. Shape:
  // { "1": 10, "2": 8, "3": 6, "4": 5, "5": 4, "6": 3, "7": 2, "8": 1, "DNF": 0 }
  // DNS always scores 0 regardless of this table (spec section 9) and is
  // enforced in lib/scoring.ts, not stored here.
  pointsSystem Json

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Set once the championship is completed — the resolved champion after
  // ties are broken (spec section 17 & 26).
  championDriverId String?

  drivers     ChampionshipDriver[]
  races       Race[]
  teams       Team[]
  driverTeams ChampionshipDriverTeam[]

  @@map("championships")
}

// Join table between Driver and Championship. `joinedRound` records which
// round a driver's championship history starts at — this is what makes a
// late joiner (spec section 8) correctly show "—" rather than DNS for the
// rounds before they joined.
model ChampionshipDriver {
  id             String   @id @default(cuid())
  championshipId String
  driverId       String
  joinedAt       DateTime @default(now())
  joinedRound    Int      @default(1)

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id])

  @@unique([championshipId, driverId])
  @@map("championship_drivers")
}

// V2: teams are championship-specific, never a permanent driver attribute
// (V2 spec section 10). A driver can belong to a different team in every
// championship they enter — team membership lives entirely on
// ChampionshipDriverTeam below, keyed off this table's rows.
model Team {
  id             String   @id @default(cuid())
  championshipId String
  name           String
  abbreviation   String
  colour         String
  logoUrl        String?
  createdAt      DateTime @default(now())

  championship Championship             @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  driverTeams  ChampionshipDriverTeam[]

  // Lets ChampionshipDriverTeam take a composite FK on (teamId,
  // championshipId), which is what guarantees a team can only ever be
  // assigned within its own championship at the database level.
  @@unique([id, championshipId])
  @@map("teams")
}

// V2: the driver <-> team relationship for one championship. One row per
// driver per championship (V2 spec section 10) — the unique constraint
// below is what enforces "one team per driver per championship" at the DB
// level. "Team must belong to the same championship" is enforced by the
// composite FK on team; "driver must be registered for the championship"
// is enforced by the enforce_driver_registered_for_team trigger added in
// v2_triggers_addition.sql, matching how race_results immutability is
// already trigger-enforced rather than relying on app code alone.
model ChampionshipDriverTeam {
  id             String   @id @default(cuid())
  championshipId String
  driverId       String
  teamId         String
  createdAt      DateTime @default(now())

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId, championshipId], references: [id, championshipId], onDelete: Cascade)

  @@unique([championshipId, driverId])
  @@map("championship_driver_teams")
}

model Race {
  id             String     @id @default(cuid())
  championshipId String
  roundNumber    Int
  trackName      String
  raceDate       DateTime?
  status         RaceStatus @default(UPCOMING)

  // Audit trail (spec section 34) — who completed the race and when.
  submittedById String?
  submittedAt   DateTime?

  championship Championship @relation(fields: [championshipId], references: [id], onDelete: Cascade)
  submittedBy  User?        @relation("RaceSubmittedBy", fields: [submittedById], references: [id])
  results      RaceResult[]

  @@unique([championshipId, roundNumber])
  @@map("races")
}

// Immutable once written — see prisma/triggers.sql, which enforces this at
// the database level as well as the application level (spec section 14).
model RaceResult {
  id                 String       @id @default(cuid())
  raceId             String
  driverId           String
  resultStatus       ResultStatus
  finishingPosition  Int?
  championshipPoints Int

  submittedById String?
  submittedAt   DateTime @default(now())

  race        Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  driver      Driver @relation(fields: [driverId], references: [id])
  submittedBy User?  @relation("ResultSubmittedBy", fields: [submittedById], references: [id])

  @@unique([raceId, driverId])
  @@map("race_results")
}
