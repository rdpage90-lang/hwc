# PostgreSQL connection string. Works with Vercel Postgres, Neon, Supabase,
# Railway, or a local/self-hosted Postgres instance.
DATABASE_URL="postgresql://user:password@host:5432/hwc?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# The public URL this app is deployed at (needed by NextAuth in production).
# For local dev this can stay as-is.
NEXTAUTH_URL="http://localhost:3000"

# Used only once, by `npm run db:seed`, to create the first admin account.
# Change the password immediately after your first login.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"
